# Git
.git
.gitignore

# 개발 파일
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist/
build/

# 테스트
tests/
.pytest_cache/
.coverage
htmlcov/

# 환경
.env
