# ===========================================
# 주식왕 봇 환경 변수 설정
# ===========================================

# 데이터베이스 URL
# 로컬 개발: SQLite
DATABASE_URL=sqlite:///./stock_king.db

# Railway 배포: PostgreSQL (자동 설정됨)
# DATABASE_URL=postgresql://user:password@host:port/database

# 한국투자증권 KIS API (https://apiportal.koreainvestment.com)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
# 모의투자: https://openapivts.koreainvestment.com:29443
# 실전투자: https://openapi.koreainvestment.com:9443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# ===========================================
# 스킬 서버 인증 (운영 필수)
# ===========================================
# /skill은 공개 POST 엔드포인트다. 이 키가 없으면 누구나 임의의 user.id로
# 게임 명령을 실행할 수 있으므로, 운영 환경에서는 미설정 시 서버가 기동하지 않는다.
#
# 카카오 챗봇 관리자센터 > 스킬 설정에서 같은 헤더/값을 등록해야 한다.
# 값은 충분히 긴 랜덤 문자열을 쓴다:  python -c "import secrets;print(secrets.token_urlsafe(32))"
SKILL_API_KEY=
SKILL_API_KEY_HEADER=X-Skill-Key

# ===========================================
# 선택 설정
# ===========================================
# /admin/* 엔드포인트 인증 (미설정 시 임시 토큰 자동 생성 + 경고)
ADMIN_TOKEN=

# true면 CORS 전체 허용 + 디버그 엔드포인트 활성화 + 스킬 인증 생략 (로컬 전용)
DEV_MODE=false

# 카카오 스킬 5초 SLA 대응
SKILL_RESPONSE_BUDGET=3.5
KIS_API_TIMEOUT=1.5
PUBLIC_DATA_API_TIMEOUT=2.0
DB_POOL_TIMEOUT=2.0

# KIS 유량 제한 / 서킷 브레이커
KIS_MIN_CALL_INTERVAL=0.1
KIS_CIRCUIT_FAILURE_THRESHOLD=5
KIS_CIRCUIT_RECOVERY_TIMEOUT=60

# 공공데이터포털 (선택)
PUBLIC_DATA_SERVICE_KEY=
